# ══════════════════════════════════════════════
# CREDENCIALES DE MERCADOPAGO
# Obtén las tuyas en: https://www.mercadopago.com.mx/developers/panel/app
#
# Estas MISMAS variables tienen que existir en Vercel:
#   Project → Settings → Environment Variables (entorno Production)
# Si el nombre no coincide exacto, el checkout devuelve error 500.
# ══════════════════════════════════════════════

# Access Token (SECRETO — nunca compartir ni subir a GitHub)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave secreta para validar los webhooks.
# MercadoPago → Tus integraciones → tu app → Webhooks → "Clave secreta"
# Sin esto, cualquiera puede mandar notificaciones de pago falsas.
MP_WEBHOOK_SECRET=

# URL del sitio (sin / al final)
SITE_URL=https://botanicastudio.mx
