{
  "buildCommand": "npm run build",
  "public": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/panel",
      "destination": "/panel/index.html"
    },
    {
      "source": "/panel/:path*",
      "destination": "/panel/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}